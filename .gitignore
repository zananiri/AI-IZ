# Bulk legal corpus (scripts/legal_data/): downloaded and generated data, never committed.
# The curated law PDFs directly in legal_txt/ stay tracked.
legal_txt/laws/
legal_txt/procedural_rules/
legal_txt/supreme_court/
legal_txt/metadata/
legal_txt/_manifests/
legal_txt/_sample/
# The built corpus vectordb/jsonl zips (Kaggle Output): far too big for git, and rebuildable from
# the fetch above + scripts/legal_data/vectorize.py. Install locally with install_corpus.py, or
# upload as a private Kaggle Dataset for notebooks that need it as an input (see notebooks/).
legal_txt/chroma_bkp/

# The bulk corpus archives (1.3 GB) live in the Kaggle dataset, not in git
legal_txt/Legal_Corpus/
*.log

# The attorney's case files (scripts/ingest_case_files.py): privileged client material, never
# committed. Only the folder's README is tracked. Their index lives under data/ (ignored above).
legal_data/*
!legal_data/README.md
