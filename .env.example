# Copy to .env and adjust for your environment. docker-compose.yml reads
# these; nothing here is required at Python-import time (config/config.yaml
# is the source of truth for the app itself).

VLLM_MODEL_REPO=google/gemma-4-31B-it   # gated; ~33GB once FP8-quantized: a GPU above 40GB
VLLM_QUANTIZATION=fp8
VLLM_MAX_MODEL_LEN=16384
VLLM_KV_CACHE_DTYPE=auto   # fp8 if the 16k context doesn't fit next to the weights
VLLM_GPU_MEM_UTIL=0.90
VLLM_GUIDED_BACKEND=xgrammar

DOCSLIDES_API_URL=http://localhost:8456
DOCSLIDES_APP_PORT=8456
