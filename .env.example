# Copy to .env and adjust for your environment. docker-compose.yml reads
# these; nothing here is required at Python-import time (config/config.yaml
# is the source of truth for the app itself).

QWEN_MODEL_REPO=Qwen/Qwen3-32B-AWQ
QWEN_QUANTIZATION=awq
QWEN_MAX_MODEL_LEN=8192
QWEN_GPU_MEM_UTIL=0.90
QWEN_GUIDED_BACKEND=xgrammar

DOCSLIDES_API_URL=http://localhost:8456
DOCSLIDES_APP_PORT=8456
